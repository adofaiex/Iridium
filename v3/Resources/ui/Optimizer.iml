<Iris>
    <VBox gap="4">
        <!-- 大标题：与其他顶层 Tab 保持一致 -->
        <Text text={localize('OptimizerSettings')} style="title" />
        <Separator />

        <!-- 总开关：所有子 Tab 共享，置于子 Tab 条上方 -->
        <HBox align="center">
            <Text text={localize('EnableOptimizer')} style="label" />
            <Icon type="information" on-click="OnInfoToggle('EnableOptimizer')" />
            <Fill />
            <Switch value={settings.optimizer.enableOptimizer} on-changed="OnOptimizerToggled" />
        </HBox>
        {isInfoExpanded('EnableOptimizer') && <Text text={localize('EnableOptimizerInfo')} style="hint" />}

        <!-- 优化器子 Tab 条：basics / gameplay / fx / advanced -->
        <HBox>
            <Button text={localize('SubTabBasics')} class={settings.optimizerSubTab == 'basics' ? 'primary' : 'element'} on-click="OnOptimizerSubTabClick('basics')" />
            <Button text={localize('SubTabGameplay')} class={settings.optimizerSubTab == 'gameplay' ? 'primary' : 'element'} on-click="OnOptimizerSubTabClick('gameplay')" />
            <Button text={localize('SubTabFx')} class={settings.optimizerSubTab == 'fx' ? 'primary' : 'element'} on-click="OnOptimizerSubTabClick('fx')" />
            <Button text={localize('SubTabAdvanced')} class={settings.optimizerSubTab == 'advanced' ? 'primary' : 'element'} on-click="OnOptimizerSubTabClick('advanced')" />
        </HBox>

        {settings.optimizer.enableOptimizer && <>
            {settings.optimizerSubTab == 'basics' && <Reference path="@OptimizerBasics.iml" />}
            {settings.optimizerSubTab == 'gameplay' && <Reference path="@OptimizerGameplay.iml" />}
            {settings.optimizerSubTab == 'fx' && <Reference path="@OptimizerFx.iml" />}
            {settings.optimizerSubTab == 'advanced' && <Reference path="@OptimizerAdvanced.iml" />}
        </>}
    </VBox>
</Iris>
