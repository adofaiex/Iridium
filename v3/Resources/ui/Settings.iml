<Iris>
    <Resources>
        <Reference path="@Theme.iml" />

        <Template name="LangBtn">
            <Button text={item.displayName} class={settings.language == item.key ? 'primary' : 'element'} on-click="OnLanguageClick(item.key)" />
        </Template>
    </Resources>

    <VBox class="padding">
        <!-- Tab bar -->
        <HBox>
            <Button text={localize('GeneralSettings')} class={settings.currentTab == 'general' ? 'primary' : 'element'} on-click="OnTabClick('general')" />
            <Button text={localize('OptimizerSettings')} class={settings.currentTab == 'optimizer' ? 'primary' : 'element'} on-click="OnTabClick('optimizer')" />
            <Button text={localize('EditorSettings')} class={settings.currentTab == 'editor' ? 'primary' : 'element'} on-click="OnTabClick('editor')" />
            <Button text={localize('CompatibilitySettings')} class={settings.currentTab == 'compatibility' ? 'primary' : 'element'} on-click="OnTabClick('compatibility')" />
            <Button text={localize('AudioSettings')} class={settings.currentTab == 'audio' ? 'primary' : 'element'} on-click="OnTabClick('audio')" />
            <Fill />
            <Text text={"Iridium " + getVersion()} style="text-secondary" />
        </HBox>

        <!-- Content area -->
        <View class="background">
            <ScrollView scrollPosition="contentScroll" height="500">
                {settings.currentTab == 'general' && <Reference path="@General.iml" />}
                {settings.currentTab == 'optimizer' && <Reference path="@Optimizer.iml" />}
                {settings.currentTab == 'editor' && <Reference path="@Editor.iml" />}
                {settings.currentTab == 'compatibility' && <Reference path="@Compatibility.iml" />}
                {settings.currentTab == 'audio' && <Reference path="@Audio.iml" />}
            </ScrollView>
        </View>

        <!-- Async processing status -->
        <Text text={getAsyncStatus()} style="text-secondary" />
    </VBox>
</Iris>
