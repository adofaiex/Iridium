<Iris>
    <VBox gap="4">
        <Text text={localize('AudioSettings')} style="title" />
        <Separator />

        <Text text={localize('HitSoundSettings')} style="subtitle" />
        <Separator />

        <HBox align="center">
            <Text text={localize('EnableHitSoundPitch')} style="label" />
            <Icon type="information" on-click="OnInfoToggle('EnableHitSoundPitch')" />
            <Fill />
            <Switch value={settings.hitSound.enableHitSoundPitch} on-changed="OnEnableHitSoundPitchToggled" />
        </HBox>
        {isInfoExpanded('EnableHitSoundPitch') && <Text text={localize('EnableHitSoundPitchInfo')} style="hint" />}

        <Separator />
        <Text text={localize('AsyncInputSettings')} style="subtitle" />
        <Separator />

        <HBox align="center">
            <Text text={localize('EnableAsyncInput')} style="label" />
            <Icon type="information" on-click="OnInfoToggle('EnableAsyncInput')" />
            <Fill />
            <Switch value={settings.asyncInput.enableAIO} on-changed="OnAsyncInputToggled" />
        </HBox>
        {isInfoExpanded('EnableAsyncInput') && <Text text={localize('EnableAsyncInputInfo')} style="hint" />}
        <Text text={localize('AsyncInputWarning')} style="secondary" />

        <Separator />
        <Text text={localize('LevelSelectSettings')} style="subtitle" />
        <Separator />

        <HBox align="center">
            <Text text={localize('EnableLobbyMusicPatch')} style="label" />
            <Icon type="information" on-click="OnInfoToggle('EnableLobbyMusicPatch')" />
            <Fill />
            <Switch value={settings.lobbyMusic.enableLobbyMusicPatch} on-changed="OnLobbyMusicPatchToggled" />
        </HBox>
        {isInfoExpanded('EnableLobbyMusicPatch') && <Text text={localize('EnableLobbyMusicPatchInfo')} style="hint" />}

        {settings.lobbyMusic.enableLobbyMusicPatch && <>
            <Separator />
            <HBox align="center">
                <Text text={localize('EnableCustomBpm')} style="label" />
                <Icon type="information" on-click="OnInfoToggle('EnableCustomBpm')" />
                <Fill />
                <Switch value={settings.lobbyMusic.enableCustomBpm} on-changed="OnEnableCustomBpmToggled" />
            </HBox>
            {isInfoExpanded('EnableCustomBpm') && <Text text={localize('EnableCustomBpmInfo')} style="hint" />}

            {settings.lobbyMusic.enableCustomBpm && <>
                <Separator />
                <HBox align="center">
                    <Text text={localize('CustomBpm')} style="label" />
                    <Fill />
                    <Slider value={settings.lobbyMusic.customBpm} min="60" max="240" step="1" showValue="true" on-changed="OnCustomBpmChanged" />
                </HBox>
            </>}

            <Separator />
            <HBox align="center">
                <Text text={localize('LobbyFastMusic')} style="label" />
                <Icon type="information" on-click="OnInfoToggle('LobbyFastMusic')" />
                <Fill />
                <Switch value={settings.lobbyMusic.fastMusic} on-changed="OnLobbyFastMusicToggled" />
            </HBox>
            {isInfoExpanded('LobbyFastMusic') && <Text text={localize('LobbyFastMusicInfo')} style="hint" />}

            <Separator />
            <HBox align="center">
                <Text text={localize('LobbyCustomMusic')} style="label" />
                <Icon type="information" on-click="OnInfoToggle('LobbyCustomMusic')" />
                <Fill />
                <Switch value={settings.lobbyMusic.customMusic} on-changed="OnLobbyCustomMusicToggled" />
            </HBox>
            {isInfoExpanded('LobbyCustomMusic') && <Text text={localize('LobbyCustomMusicInfo')} style="hint" />}

            {settings.lobbyMusic.customMusic && <>
                <Separator />
                <HBox align="center">
                    <Text text={localize('LobbyDefaultMusicPath')} style="label" />
                    <Fill />
                    <TextField value={settings.lobbyMusic.defaultMusicPath} on-text-submit="OnDefaultMusicPathChanged" />
                    <Button text={localize('Apply')} on-click="OnApplyDefaultMusic" />
                </HBox>

                <Separator />
                <HBox align="center">
                    <Text text={localize('LobbyFastMusicPath')} style="label" />
                    <Fill />
                    <TextField value={settings.lobbyMusic.fastMusicPath} on-text-submit="OnFastMusicPathChanged" />
                    <Button text={localize('Apply')} on-click="OnApplyFastMusic" />
                </HBox>

                <HBox align="center">
                    <Button text={localize('LobbyReloadMusic')} on-click="OnLobbyReloadMusic" />
                </HBox>
            </>}
        </>}
    </VBox>
</Iris>
