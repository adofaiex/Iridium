<Iris>
    <Resources>
        <Reference path="@Theme.iml" />

        <Style name="panel" on=".panel">
            <Setter property="padding" value="12,12,12,12" />
            <Setter property="radius" value="8" />
        </Style>
        <Style name="text" on=".text">
            <Setter property="fontSize" value="14" />
        </Style>
    </Resources>

    <HBox class="panel bg-default" gap="8">
        <Icon type={iconType} />
        <Text text={message} class="text text-normal" />
        <Fill />
        {showStop && <Button text={stopText} class="primary" on-click="OnStop" width="80" />}
    </HBox>
</Iris>
